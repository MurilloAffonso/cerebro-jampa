# =====================================================================
# .gitignore — CEREBRO.JAMPA (raiz)
# Última revisão: 2026-05-29 (Fase 2 — limpeza técnica)
# Fonte canônica: ../FONTE-DA-VERDADE.md
# =====================================================================

# ── Node / Next.js (coberto também em _site/.gitignore) ──────────────
node_modules/
.next/

# ── Build artifacts do Next.js (gerados, nunca versionar) ────────────
_site/.next/
_site/out/
_site/out.zip
_site/tsconfig.tsbuildinfo

# ── Env ──────────────────────────────────────────────────────────────
.env
.env.local

# ── Playwright MCP ───────────────────────────────────────────────────
.playwright-mcp/

# ── Python ───────────────────────────────────────────────────────────
__pycache__/

# ── Logs ─────────────────────────────────────────────────────────────
*.log

# ── OS ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Obsidian (cache e workspace — mudam a cada abertura) ─────────────
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/graph.json

# ── Claude Code (configurações locais) ───────────────────────────────
.claude/settings.local.json
*.canvas

# ── Editor ───────────────────────────────────────────────────────────
.vscode/

# ── Dados sensíveis — nunca commitar ─────────────────────────────────
_seguro/

# ── Imagens soltas na raiz (Fase 2 reorganizou para _design/refs/) ──
# Evitar reintrodução acidental de prints/capturas na raiz.
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp

# ── Google Business Profile local ────────────────────────────────────
google-business-profile/credentials.json
google-business-profile/token.json
google-business-profile/.env

# ── Arquivos locais do executor e dumps brutos ───────────────────────
iniciar-cerebro-jampa.bat
reviews-raw.json
