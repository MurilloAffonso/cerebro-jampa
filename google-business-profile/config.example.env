# Modelo de variaveis de ambiente para o modulo Google Business Profile.
# COPIAR ESTE ARQUIVO PARA .env E PREENCHER COM VALORES REAIS.
# NUNCA commitar o .env real. Veja .gitignore.

# OAuth 2.0 — credenciais geradas no Google Cloud Console
# (Tipo: Aplicativo para computador / Desktop)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Refresh token gerado pelo fluxo OAuth inicial (scripts/auth/login.ts)
# Cuidado: este token concede acesso de longo prazo ao perfil.
GOOGLE_REFRESH_TOKEN=

# Identificadores do perfil — obter via Account Management API
# (accounts.list e accounts.locations.list)
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=

# Nome canonico do recurso (formato: accounts/{accountId}/locations/{locationId})
GBP_PROFILE_NAME=
